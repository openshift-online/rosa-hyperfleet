  "sre_prometheus_oidc_client_id": {{ regional_cluster.sre_prometheus_oidc_client_id | default("") | tojson }},
  "sre_thanos_oidc_client_id": {{ regional_cluster.sre_thanos_oidc_client_id | default("") | tojson }},
  "regional_id": "{% if eph_prefix %}{{ eph_prefix }}-regional{% else %}regional{% endif %}",
  "environment": "{{ environment }}",
  "zoa_lambda_image_tag": {{ regional_cluster.zoa_lambda_image_tag | tojson }},
  "zoa_runner_image_tag": {{ regional_cluster.zoa_runner_image_tag | tojson }},
  "zoa_lambda_source_image": {{ regional_cluster.zoa_lambda_source_image | tojson }},
  "zoa_runner_source_image": {{ regional_cluster.zoa_runner_source_image | tojson }},
  "worker_node_ami_id": {% if worker_node_ami %}{{ worker_node_ami.id | tojson }}{% else %}""{% endif %},
  "eph_prefix": "{{ eph_prefix | default('') }}"
