{
  "_generated": "DO NOT EDIT - Generated by render.py",
  "app_code": "{{ terraform_tags.app_code }}",
  "service_phase": "{{ terraform_tags.service_phase }}",
  "cost_center": "{{ terraform_tags.cost_center }}",
  "environment": "{{ environment }}",
  "account_id": "{{ mc.account_id }}",
  "region": "{{ aws_region }}",
  "alias": "{{ mc.management_id }}",
  "management_id": "{{ mc.management_id }}",
  "regional_aws_account_id": "{{ account_id }}",
  "zoa_lambda_image_tag": {{ regional_cluster.zoa_lambda_image_tag | default('') | tojson }},
  "zoa_runner_image_tag": {{ regional_cluster.zoa_runner_image_tag | default('') | tojson }},
  "zoa_runner_source_image": {{ regional_cluster.zoa_runner_source_image | default('') | tojson }},
  "worker_node_ami_id": {% if worker_node_ami %}{{ worker_node_ami.id | tojson }}{% else %}""{% endif %},
  "worker_node_root_volume_size": {{ worker_node_root_volume_size | default(50) | tojson }}
{%- if eph_prefix | default('', true) %},
  "eph_prefix": {{ eph_prefix | tojson }}
{%- endif %}
{%- if mc.enable_bastion is defined %},
  "enable_bastion": {{ mc.enable_bastion | tojson }}{% elif management_cluster_defaults.enable_bastion %},
  "enable_bastion": {{ management_cluster_defaults.enable_bastion | tojson }}{% endif %}{% if mc.delete %},
  "delete": true{% endif %}
}
